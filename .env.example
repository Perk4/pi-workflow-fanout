# Clamp Coach live LLM credentials. Copy to .env.local and fill one provider.
# Never commit real keys.

# OpenAI-compatible (default live path)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# PI_COACH_MODEL=gpt-4.1-mini

# Or Anthropic
# ANTHROPIC_API_KEY=
# PI_COACH_MODEL=claude-sonnet-4-5

# Optional override used by either provider
# PI_COACH_API_KEY=
# PI_COACH_BASE_URL=
