# Clamp Coach live LLM credentials. Copy to .env.local and fill one provider.
# Never commit real keys.

# OpenAI-compatible (default live path)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# PI_COACH_MODEL=gpt-4.1-mini

# Or Anthropic
# ANTHROPIC_API_KEY=
# PI_COACH_MODEL=claude-sonnet-4-5

# Optional override used by either provider
# PI_COACH_API_KEY=
# PI_COACH_BASE_URL=
# PI_COACH_PROVIDER=anthropic

# Local OpenAI-compatible (LM Studio) — no cloud key required.
# Start LM Studio, load a model, enable the local server, then uncomment:
# PI_COACH_PROVIDER=local
# PI_COACH_BASE_URL=http://127.0.0.1:1234/v1
# PI_COACH_MODEL=your-lm-studio-model-id
# Dummy key is optional; LM Studio accepts any value. Unset cloud keys above
# when using this path. Do not commit real secrets.
# PI_COACH_API_KEY=lm-studio
